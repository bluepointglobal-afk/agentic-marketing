# ──────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keys live ONLY in server/worker env — never the client.
# Each key is annotated with the build step that first needs it.
# ──────────────────────────────────────────────────────────────────────────

# ── Infrastructure (step 1+) ──
# Mongo + Redis. Defaults match docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/agentic_marketing
REDIS_URL=redis://localhost:6379

# Name of the BullMQ queue shared by the app (producer) and worker (consumer).
RUN_QUEUE_NAME=brand-runs

# ── Next.js app (step 2+) ──
# Base URL the cockpit uses for API calls. Same-origin by default.
NEXT_PUBLIC_API_BASE_URL=

# ── Worker / Agent SDK (step 4+) ──
# Anthropic key powers the query() orchestration and all subagents.
ANTHROPIC_API_KEY=

# Worker run-time tuning.
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# ── Image generation (step 5) ──
# GPT Image 2 (brand.imageModel === "gpt-image-2")
OPENAI_API_KEY=
# Nano Banana / Gemini image (brand.imageModel === "nano-banana")
GEMINI_API_KEY=

# ── Bulk variants via Kimi K2.6 on OpenRouter (step 4, swap point) ──
OPENROUTER_API_KEY=

# ── SEO data, swap point from built-in WebSearch (step 4 TODO) ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# ── Publishing (step 5) ──
# brand.publishTarget === "blotato"
# Get the key in Blotato → Settings → API (it may end with "=", keep it).
BLOTATO_API_KEY=
# Connected-account ids: Blotato → connect each social account → "Copy Account ID".
# Only set the platforms you actually use; others are skipped.
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_TWITTER_ACCOUNT_ID=
# TikTok post privacy. SELF_ONLY (private, safe for testing) is the default.
# Set PUBLIC_TO_EVERYONE to go live. Others: MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR.
BLOTATO_TIKTOK_PRIVACY=SELF_ONLY

# brand.publishTarget === "cms"
CMS_API_URL=
CMS_API_TOKEN=

# ── Funnel: post-publish landing page + email sequence (increment 3) ──
# brand.funnel.provider === "webhook" — POST the funnel payload anywhere
# (Zapier / Make / n8n). Easiest way to test the funnel end-to-end.
FUNNEL_WEBHOOK_URL=
# brand.funnel.provider === "kartra" (scaffold — wire your sequence ids)
KARTRA_APP_ID=
KARTRA_API_KEY=
KARTRA_API_PASSWORD=
